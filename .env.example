# Backend URL (no trailing slash). Locally: http://localhost:8080
VITE_API_URL=http://localhost:8080
# Leave empty to serve at "/". Use "/app/" to serve under siletry.com/app
VITE_BASE_PATH=
# Show Google / Hospital SSO buttons on the sign-in page (not wired up yet)
VITE_SHOW_SSO=false
# WhatsApp number (digits, with 91) for the "Book a call" link in setup
VITE_SUPPORT_WHATSAPP=
